# NutriPlan AI environment. Copy to .env.local (git ignored). Every value here is a safe default; no secrets.
# This file is the source for /.env.example (Lead: `cp docs/env.example .env.example`); `npm run setup` copies
# whichever exists to .env.local. `npm run doctor` tells you which mode the app will run in.

# ----- Frontend -------------------------------------------------------------
# true: /lib/api.ts serves /mocks/*.json with a 600 ms delay and never calls /app/api. Use while building screens.
NEXT_PUBLIC_USE_MOCKS=false

# ----- Data -----------------------------------------------------------------
# memory (default): JSON store under .data/, seeded with Alex and Maria, zero setup. supabase: Postgres via the keys below.
DATA_BACKEND=memory
# Where the memory store persists. "none" keeps everything in RAM (tests).
MEMORY_STORE_FILE=.data/store.json

# ----- Auth -----------------------------------------------------------------
# local (default): signed JWT cookie with email verification. Supabase remains optional.
AUTH_MODE=local
AUTH_JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=NutriPlan <onboarding@example.com>

# ----- Agents ---------------------------------------------------------------
# blank = auto: live when any model key below is set, otherwise scripted (deterministic negotiation, works offline).
AGENTS_MODE=
# Milliseconds between Agent Room events (demo pacing). Playwright overrides to 40.
AGENT_EVENT_DELAY_MS=900
# true: on a live model failure replay agents/fallbacks/<user>-plan-run.json instead of failing the run.
AGENTS_FALLBACK=true

# Model provider keys (optional; leave blank for scripted mode). Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional per agent model overrides as "provider:model-id" or "model-id" (see agents/config.ts). Blank = defaults
# (doctor/orchestrator/coach/visionA claude-sonnet-4-5, budget/monitor claude-haiku-4-5, chef gpt-4.1-mini, visionB gemini-2.5-flash).
MODEL_DOCTOR=
MODEL_CHEF=
MODEL_BUDGET=
MODEL_MONITOR=
MODEL_ORCHESTRATOR=
MODEL_COACH=
MODEL_VISION_A=
MODEL_VISION_B=
# Optimizer knobs used by the Orchestrator (optional): solver time budget in seconds and whether to compute shadow prices.
AGENTS_OPT_TIME_SEC=
AGENTS_SHADOW_PRICES=

# ----- Supabase (only for DATA_BACKEND=supabase or AUTH_MODE=supabase) -------
# Browser side (safe to expose): project URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server side: same URL and the service role key (secret; server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Data imports (optional) ----------------------------------------------
# USDA FoodData Central key for scripts/data/import-usda.ts (npm run data:usda). Not needed to run the app.
USDA_API_KEY=

# ----- Testing and build ----------------------------------------------------
# Point Playwright at a deployed URL instead of starting `npm run dev` (E2E_BASE_URL=https://nutriplan.vercel.app).
E2E_BASE_URL=
# standalone: Next standalone output for the Docker image. Leave blank for Vercel and local dev.
NEXT_OUTPUT=

# ----- Kroger (optional; real shelf prices + "Send to Kroger cart", see docs/kroger-setup.md) ----------
# Register at https://developer.kroger.com -> My Apps -> Create app with scopes product.compact, cart.basic:write,
# profile.compact and redirect URI http://localhost:3000/api/kroger/callback. Blank = Kroger routes answer
# { error, code: "kroger_not_configured" } and the app uses the curated prices in scripts/data/prices.csv.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Must match a redirect URI registered in the Kroger portal (production: https://<host>/api/kroger/callback).
KROGER_REDIRECT_URI=http://localhost:3000/api/kroger/callback
# Default store (Kroger locationId, e.g. 01400943) when the user has not picked one; also used by npx tsx scripts/data/kroger-prices.ts.
KROGER_LOCATION_ID=
# HMAC key for the OAuth state parameter. Blank = falls back to SUPABASE_SERVICE_ROLE_KEY, then KROGER_CLIENT_SECRET.
KROGER_STATE_SECRET=
# Override the API base (default https://api.kroger.com/v1) to point at a mock server for offline demos.
KROGER_API_BASE=
